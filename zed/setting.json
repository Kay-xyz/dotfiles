{
  "diff_view_style": "split",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "default_profile": "ask",
    "model_parameters": []
  },
  "terminal": {
    "dock": "right"
  },
  "theme": "Catppuccin Frappé - No Italics",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "Zed",
  "ui_font_size": 20.0,
  "buffer_font_size": 25.0,
  "theme_overrides": {
    "Catppuccin Frappé - No Italics": {
      // 编辑器与基础区域
      "background": "#3B224C",
      "editor.background": "#3B224C",
      "editor.gutter.background": "#3B224C",
      "editor.active_line.background": "#452F58",
      "editor.highlighted_line.background": "#3B224C",
      "editor.subheader.background": "#3B224C",

      // 面板与侧边栏
      "panel.background": "#3B224C",
      "surface.background": "#3B224C",
      "elevated_surface.background": "#3B224C",
      "element.background": "#3B224C",

      // 顶部与底部栏
      "title_bar.background": "#3B224C",
      "tab_bar.background": "#3B224C",
      "tab.active_background": "#452F58",
      "tab.inactive_background": "#3B224C",
      "status_bar.background": "#3B224C",
      "toolbar.background": "#3B224C",

      // 搜索与终端
      "search.match_background": "#CA9EE6",
      "terminal.background": "#3B224C",

      // 滚动条与边框
      "scrollbar.track.background": "#3B224C",
      "border": "#3B224C",
      "border.variant": "#3B224C",
      "pane_group.border": "#CA9EE6"

    }
  }

}
